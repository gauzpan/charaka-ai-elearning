// Charaka AI — data model (MVP).
// Plain Postgres so the same schema moves to Supabase later (swap DATABASE_URL).
// Content (Module/Lesson/Card) lives as typed TS in src/content, NOT in the DB —
// the DB holds user state and the two success metrics only.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Supabase's pooled (pgbouncer) connection — used at runtime by the app.
  url       = env("DATABASE_URL")
  // Supabase's direct connection — used only for migrations, which pgbouncer
  // in transaction mode can't run. Same host, port 5432 instead of 6543.
  directUrl = env("DIRECT_URL")
}

// Fixed to physician for the MVP; multi-role is a later release.
enum Role {
  PHYSICIAN
}

model User {
  id       String  @id @default(cuid())
  // Nullable so a Google login without a verified email doesn't fail account
  // creation; still unique — Postgres allows multiple NULLs under a unique
  // constraint. The email-code flow always populates this on upsert.
  email    String? @unique
  // Set once a Google OAuth login has verified this account's identity.
  googleId String? @unique
  role        Role     @default(PHYSICIAN)
  studyWindow String? // "commute" | "break" | "evening" — set in onboarding (M4)
  focusTask   String? // the task they want to get better at (onboarding)
  onboardedAt DateTime? // set when the 90-sec onboarding completes; gates /onboarding

  // Streak is a user-level fact (moved here from Progress by design).
  currentStreak  Int       @default(0)
  lastActiveDate DateTime?

  createdAt DateTime @default(now())

  loginCodes   LoginCode[]
  progress     Progress[]
  savedPrompts SavedPrompt[]
  applyIntents ApplyIntent[]
  savedTools   SavedTool[]
}

// Sign-in via a one-time numeric code, emailed to the user.
model LoginCode {
  id         String    @id @default(cuid())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  // Failed verification attempts against this code. Capped in application
  // code (MAX_CODE_ATTEMPTS) — a 6-digit code has far less entropy than a
  // long random token, so this is what keeps it from being brute-forceable
  // within its short TTL.
  attempts   Int       @default(0)

  createdAt DateTime @default(now())

  @@index([userId])
}

// One row per (user, lesson): how far through the lesson they are.
model Progress {
  id          String    @id @default(cuid())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  moduleId    String
  lessonId    String
  cardIndex   Int       @default(0) // last card reached
  completedAt DateTime?

  updatedAt DateTime @updatedAt

  @@unique([userId, lessonId])
  @@index([userId])
}

// Success metric (b): a prompt the user chose to keep from a Try-it card.
model SavedPrompt {
  id          String   @id @default(cuid())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  taskId      String
  promptText  String
  rubricScore Int? // 0–4 from the client-side rubric (M3)
  createdAt   DateTime @default(now())

  @@index([userId])
}

// Weekly-refreshed cache of AI-in-healthcare news (Resources -> AI Feed),
// fetched server-side from a curated RSS source list. A deliberate exception
// to the "content is TS, not DB" rule above: unlike static lessons/toolkit
// entries, this content changes over time and needs caching across requests.
// Refreshed by the Vercel Cron job in vercel.json hitting /api/feed/refresh,
// which replaces the full set each run — this table always holds exactly
// "this week's 10" (or fewer, if a week is genuinely thin on real coverage;
// never padded with fabricated items).
model FeedItem {
  id           String   @id @default(cuid())
  url          String   @unique
  title        String
  description  String
  thumbnailUrl String?
  sourceName   String
  // Deterministic, keyword-classified topic (see categoryFor() in
  // lib/feedSources.ts) — not AI-guessed, so it's reviewable and never
  // presents a fabricated judgment about a real article. Default is a
  // migration-safety fallback for rows that predate this column; every row
  // written by refreshFeed() gets a real computed value.
  category     String   @default("AI in Healthcare")
  publishedAt  DateTime
  fetchedAt    DateTime @default(now())

  @@index([publishedAt])
}

// A tool the user bookmarked from the AI Toolkit (Resources). toolId is the
// content slug from src/content/toolkit.ts (content is TS, not DB rows).
model SavedTool {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  toolId    String
  createdAt DateTime @default(now())

  @@unique([userId, toolId])
  @@index([userId])
}

// Success metric (a): the "I'll use this at work" tap on the recap card.
model ApplyIntent {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  lessonId  String
  createdAt DateTime @default(now())

  @@index([userId])
}
