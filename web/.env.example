# Copy to .env.local and fill in. .env.local is gitignored.

# Local dev Postgres (matches docker-compose.yml). In production (Vercel +
# Supabase) this is the pooled/pgbouncer connection string, port 6543,
# with ?pgbouncer=true appended.
DATABASE_URL="postgresql://charaka:charaka@localhost:5432/charaka?schema=public"

# Only needed in production. Supabase's direct (non-pooled) connection, port
# 5432 — Prisma uses this for migrations only, since pgbouncer in transaction
# mode can't run them. Leave unset locally (falls back to DATABASE_URL).
DIRECT_URL=""

# Server-side only — never exposed to the browser. OpenRouter key for the M3
# practice loop (model: nvidia/nemotron-3.5-lightning:free).
OPENROUTER_KEY=""

# Signs the sign-in session cookie and the short-lived Google OAuth state
# cookie. Any long random string.
AUTH_SECRET=""

# Gmail SMTP (via nodemailer) for login-code email delivery and the generic
# /api/send-email route. Unset locally — the login code is logged to the
# console and returned in the API response instead. Required in any deployed
# environment, or sign-in has no way to reach the user.
#
# EMAIL_USER: the full Gmail address to send from (e.g. yourapp@gmail.com).
#
# EMAIL_PASS: a Gmail "App Password" — NOT your normal Google account
# password. Generate one at myaccount.google.com → Security → 2-Step
# Verification (must be turned on first) → App passwords → create one named
# e.g. "Charaka AI". It's a 16-character code; paste it here with no spaces.
# Google rejects SMTP login with a regular password for virtually all
# accounts now, so this step isn't optional.
#
# Gmail also caps sending at ~500 messages/day per account — fine for an
# MVP/demo, not a real production volume. Swap for a dedicated transactional
# provider (Mailgun, Resend, SES, etc.) before that matters.
EMAIL_USER=""
EMAIL_PASS=""

# Shared secret required on every call to /api/send-email (sent by the caller
# as the `x-api-secret` request header). Any long random string — without
# this set, the route refuses all requests rather than allowing them through
# unauthenticated (fail closed, not fail open).
EMAIL_API_SECRET=""

# Public site origin, no trailing slash (e.g. https://your-app.vercel.app).
# Defaults to http://localhost:3000. Used to build the Google OAuth redirect
# URI.
NEXT_PUBLIC_SITE_URL=""

# Google OAuth client (Google Cloud Console → APIs & Services → Credentials).
# Add both http://localhost:3000/api/auth/google/callback and your deployed
# callback URL to the client's Authorized redirect URIs.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Mixpanel project token — server-side only, never exposed to the browser.
# Used for the two backend-observable events (account_created,
# lesson_completed). See src/lib/mixpanel.ts.
MIXPANEL_TOKEN=""

# Same Mixpanel project token, client-exposed (Mixpanel project tokens are
# designed to be public/write-only — this is expected, not a leak). Powers
# client-side autocapture (clicks, pageviews, scroll) and Session Replay. See
# src/lib/mixpanelClient.ts. Session Replay masks all text/inputs and blocks
# images/video by default — verified against current Mixpanel docs, not
# changed here. One project is fine for Quick Start; consider a dev/prod
# split and dialing down record_sessions_percent before real production
# traffic (currently 100% — see src/lib/mixpanelClient.ts).
NEXT_PUBLIC_MIXPANEL_TOKEN=""

# Verifies the Vercel Cron job that refreshes the AI Feed weekly (see
# vercel.json, api/feed/refresh/route.ts). Vercel auto-sends this as
# `Authorization: Bearer <value>` on cron-triggered requests once it's set.
# Unset locally — the refresh endpoint is open in dev. Required in any
# deployed environment, or anyone could trigger the refresh.
CRON_SECRET=""
